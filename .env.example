# ============================================================================
# Galerie Apanage — variables d'environnement
# ----------------------------------------------------------------------------
# RÈGLE D'OR : on doit pouvoir démarrer le dev SANS UNE SEULE CLÉ.
# Chaque service de la couche IA/externe reste en MOCK tant que sa clé est vide.
# Copier ce fichier en `.env.local` et ne remplir que ce dont on a besoin.
# Priorité RGPD/UE : briques hébergées/compatibles UE (cf. §6 des specs).
# ============================================================================

# ---------------------------------------------------------------------------
# SUPABASE (Postgres + Auth magic-link + Storage) — colonne vertébrale
# Sans ces variables, l'app démarre quand même : les écrans s'affichent,
# les données sont servies par le mock store en mémoire.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : UNIQUEMENT côté serveur (jamais exposée au client).
# Sert aux opérations privilégiées (séquestre, décaissements, jobs).
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du site (callbacks magic-link, liens e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# COUCHE DE SERVICES IA / EXTERNE
# Un connecteur par tâche. Clé vide => service en MOCK (placeholders).
# ---------------------------------------------------------------------------

# LLM — intake conversationnel + génération texte (CDC, rapports, annonce, devis)
# Recommandé UE : Mistral (https://mistral.ai)
LLM_PROVIDER=mock            # mock | mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# ASR — transcription + diarisation FR de l'audio d'appel
# Recommandé : AssemblyAI ou Gladia (FR)
ASR_PROVIDER=mock            # mock | assemblyai | gladia
ASSEMBLYAI_API_KEY=
GLADIA_API_KEY=

# IMAGE — génération / retouche de visuels produit
# Recommandé : Pollinations / Cloudflare Workers AI
IMAGE_PROVIDER=mock          # mock | pollinations | cloudflare
POLLINATIONS_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# SCRAPER — extraction d'annonces (whitelist de sources)
SCRAPER_PROVIDER=mock        # mock | http
SCRAPER_API_KEY=

# 3D — pipeline Gaussian Splatting / scènes GLB
# Recommandé : Luma (ou higgsfield via MCP, mocké pour l'instant)
THREED_PROVIDER=mock         # mock | luma | higgsfield
LUMA_API_KEY=

# BANKING — open banking (listTransactions pour rapprochement)
# Recommandé FR/UE : GoCardless (Bank Account Data) / Bridge / Powens
BANKING_PROVIDER=mock        # mock | gocardless | bridge | powens
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# PAYMENT / SÉQUESTRE — encaissement, décaissement, wallets ségrégués
# Recommandé UE : Lemonway (ou Mangopay). Agent enregistré ACPR.
PAYMENT_PROVIDER=mock        # mock | lemonway | mangopay
LEMONWAY_API_KEY=
LEMONWAY_ENV=sandbox

# EMAIL — magic-link + notifications transactionnelles
# Auth gérée par Supabase ; Brevo (FR) en option pour le transactionnel.
EMAIL_PROVIDER=mock          # mock | supabase | brevo
BREVO_API_KEY=
EMAIL_FROM=contact@galerie-apanage.fr

# STORAGE — photos / PDF documents / assets 3D
# Par défaut : Supabase Storage (mêmes clés que ci-dessus).
STORAGE_PROVIDER=mock        # mock | supabase

# ---------------------------------------------------------------------------
# DIVERS
# ---------------------------------------------------------------------------
# Force tous les services en mock même si des clés sont présentes (utile en CI)
SERVICES_FORCE_MOCK=false
